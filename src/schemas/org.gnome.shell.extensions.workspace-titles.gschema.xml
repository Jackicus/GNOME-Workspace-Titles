<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <enum id="org.gnome.shell.extensions.workspace-titles.position">
        <value nick="top" value="0"/>
        <value nick="center" value="1"/>
    </enum>
    <enum id="org.gnome.shell.extensions.workspace-titles.size">
        <value nick="small" value="0"/>
        <value nick="large" value="1"/>
        <value nick="huge" value="2"/>
    </enum>
    <schema id="org.gnome.shell.extensions.workspace-titles" path="/org/gnome/shell/extensions/workspace-titles/">
        <key name="rename-shortcut" type="as">
            <default><![CDATA[['<Super>F2']]]></default>
            <summary>Rename the current workspace</summary>
            <description>Opens the dialog that names the workspace in view. Empty is no shortcut.</description>
        </key>
        <key name="show-indicator" type="b">
            <default>true</default>
            <summary>Show the rename button</summary>
            <description>Whether a button in the top bar opens the rename dialog.</description>
        </key>
        <key name="show-on-hover" type="b">
            <default>true</default>
            <summary>Show the title on hover</summary>
            <description>Whether resting the pointer on the workspace indicator at the left of the top bar shows the current workspace's title.</description>
        </key>
        <key name="title-position" enum="org.gnome.shell.extensions.workspace-titles.position">
            <default>'top'</default>
            <summary>Where the title is shown</summary>
            <description>At the top of the screen, or in its middle.</description>
        </key>
        <key name="title-size" enum="org.gnome.shell.extensions.workspace-titles.size">
            <default>'large'</default>
            <summary>How large the title is</summary>
            <description>The size of the workspace name shown on a switch.</description>
        </key>
    </schema>
</schemalist>
